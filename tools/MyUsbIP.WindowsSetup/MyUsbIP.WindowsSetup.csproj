<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MyUsbIP.Setup</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == 'win-x64'">app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SetupRole Condition="'$(SetupRole)' == ''">all</SetupRole>
    <SetupMode Condition="'$(SetupMode)' == ''">online</SetupMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Embedded/$(SetupRole)-setup.json" LogicalName="MyUsbIP.Setup.manifest.json" Condition="Exists('Embedded/$(SetupRole)-setup.json')" />
    <EmbeddedResource Include="Embedded/$(SetupRole)-bundle.zip" LogicalName="MyUsbIP.Setup.bundle.zip" Condition="'$(SetupMode)' == 'offline' And Exists('Embedded/$(SetupRole)-bundle.zip')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyUsbIP.SmokeTests" />
  </ItemGroup>
  <Target Name="ValidateSetupPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(SetupRole)' != 'server' And '$(SetupRole)' != 'client'" Text="Publish requires SetupRole=server or client." />
    <Error Condition="'$(SetupMode)' != 'online' And '$(SetupMode)' != 'offline'" Text="SetupMode must be online or offline." />
    <Error Condition="!Exists('Embedded/$(SetupRole)-setup.json')" Text="Run Build-WindowsBundles.ps1 before publishing setup." />
    <Error Condition="'$(SetupMode)' == 'offline' And !Exists('Embedded/$(SetupRole)-bundle.zip')" Text="Offline setup requires a verified embedded bundle." />
  </Target>
</Project>
