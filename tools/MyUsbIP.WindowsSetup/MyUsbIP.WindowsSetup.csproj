<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MyUsbIP.Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SetupRole Condition="'$(SetupRole)' == ''">dual</SetupRole>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Embedded\dependencies.windows.json" LogicalName="MyUsbIP.Setup.dependencies.windows.json" Condition="Exists('Embedded\dependencies.windows.json')" />
    <EmbeddedResource Include="Embedded\server-payload.zip" LogicalName="MyUsbIP.Setup.server-payload.zip"
                      Condition="Exists('Embedded\server-payload.zip') And ('$(SetupRole)' == 'server' Or '$(SetupRole)' == 'dual')" />
    <EmbeddedResource Include="Embedded\client-payload.zip" LogicalName="MyUsbIP.Setup.client-payload.zip"
                      Condition="Exists('Embedded\client-payload.zip') And ('$(SetupRole)' == 'client' Or '$(SetupRole)' == 'dual')" />
    <EmbeddedResource Include="Embedded\server-dependency.bin" LogicalName="MyUsbIP.Setup.server-dependency.bin"
                      Condition="Exists('Embedded\server-dependency.bin') And ('$(SetupRole)' == 'server' Or '$(SetupRole)' == 'dual')" />
    <EmbeddedResource Include="Embedded\client-dependency.bin" LogicalName="MyUsbIP.Setup.client-dependency.bin"
                      Condition="Exists('Embedded\client-dependency.bin') And ('$(SetupRole)' == 'client' Or '$(SetupRole)' == 'dual')" />
  </ItemGroup>
</Project>
